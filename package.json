{
  "name": "cuisine-2.0",
  "version": "1.0.0",
  "description": "A family recipe library: books of recipes on 3D shelves, hosted on a local server",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file=.env --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "knip": "knip",
    "check": "npm run lint && npm run knip && npm test",
    "nutrition:build": "node scripts/nutrition/build-nutrition-db.mjs",
    "ocr:vendor": "node scripts/ocr/vendor.mjs",
    "postinstall": "node scripts/ocr/vendor.mjs",
    "predev": "node scripts/ocr/vendor.mjs",
    "prebuild": "node scripts/ocr/vendor.mjs"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "nanoid": "^5.0.9",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jspdf": "^4.2.1",
    "knip": "^5.88.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.171.0",
    "vite": "^6.0.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
