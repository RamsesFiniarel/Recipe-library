# Port used by the Express server (API in dev, API + static build in production)
PORT=3000

# Path to the SQLite database file (created, empty, on first run)
DB_PATH=./data/cuisine.db

# Names the app may also be reached by, besides an IP address, localhost and
# the machine's own name (comma separated). Any other name is refused: it
# protects against DNS rebinding from a web page opened on the network.
# ALLOWED_HOSTS=cuisine.maison

# Where the server keeps its daily copies of the database (the last 7).
# BACKUP_DIR=./data/backups
